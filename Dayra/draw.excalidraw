      "updated": 1786788928332,
      "link": null,
      "locked": false,
      "text": "Packages used and purposes:-\n1. express - for server \n2. ejs for templates\n3. mongoose for odm(object data modelling)\n4. method-override for update and delete routes\n5. ejs mate for layouts and boilerplate to reducing reuse of code",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Packages used and purposes:-\n1. express - for server \n2. ejs for templates\n3. mongoose for odm(object data modelling)\n4. method-override for update and delete routes\n5. ejs mate for layouts and boilerplate to reducing reuse of code",
      "autoResize": true,
      "lineHeight": 1.25
    },
